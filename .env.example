# URL pública do site (sitemap, robots, Open Graph). Sem barra final.
# Obrigatória no build de produção fora da Vercel: sem ela o build falha (LR-02).
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Google Analytics 4. Vazio = sem medição nem banner de cookies.
NEXT_PUBLIC_GA_ID=

# true força noindex. Em qualquer deploy da Vercel (dev/preview) o noindex é automático (VERCEL=1).
NEXT_PUBLIC_NOINDEX=
